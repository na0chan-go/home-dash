APP_ADDR=:8080
APP_VERSION=unknown
DB_PATH=/data/app.db
GARBAGE_SCHEDULE_PATH=config/garbage_schedule.json
WEB_DIST_PATH=web/dist
CORS_ALLOW_ORIGINS=
# バックアップ設定
BACKUP_DIR=/data/backups
BACKUP_KEEP=30
BACKUP_INTERVAL=24h
# 任意: 設定すると /api/v1/* で Bearer 認証を有効化
AUTH_TOKEN=replace-with-long-random-token
